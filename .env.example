# =============================================================================
# 部署档位（二选一）
# =============================================================================
# multi：PostgreSQL + Redis + OpenSandbox，可运行多个 worker。
# standalone：单个 SQLite 文件 + 进程内运行状态 + WSL2/bubblewrap，只允许单 worker。
# 默认保留 multi，避免已有部署行为被静默替换。
DEPLOYMENT_MODE=multi

# standalone 推荐只配置 SQLITE_PATH。DATABASE_URL 与 SQLITE_PATH 同时存在时，
# 二者必须指向同一个文件；业务表、LangGraph checkpoint 与 Store 共用这个库。
# 不填 SQLITE_PATH 时默认是 ~/.ai-coding-harness/harness.sqlite3。
SQLITE_PATH=
DATABASE_URL=

# 留空时：multi -> opensandbox；standalone -> wsl。
SANDBOX_PROVIDER=

# standalone/WSL 配置。后端本身必须跑在 WSL2 内；Windows 只负责启动和打开界面。
WSL_DISTRO=ai-coding-harness
WSL_USER=harness
WSL_ROOT=/home/harness/.ai-coding-harness/sessions
WSL_BWRAP=/usr/bin/bwrap
WSL_COMMAND_TIMEOUT_SECONDS=600
# 第一版保留普通网络；后续接入 allowlist 代理后再改为 false。
WSL_ALLOW_NETWORK=true

# LLM — DeepSeek / Kimi / GPT / GLM / Qwen，都走 OpenAI 兼容接口。
#
# **2026-10-15 起这里不再有「出厂默认」**（用户口径：干掉它）：谁用哪个模型一律在
# 设置页 →「模型配置」里按**智能体**填（存表 model_endpoints，下一轮生效）。
# 下面这五组「模型连接」因此**已作废**，留着只为看默认地址 / 历史值：
# 唯一还在用的 .env 凭据是下面那对 ``GLM_API_KEY`` / ``GLM_BASE_URL``（web 搜索用它）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-pro

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL_NAME=kimi-k2.6

# 各模型上下文窗口（tokens）：**已作废**（2026-10-15）。窗口现在的口径是
# 「那一行手填 → 按**模型**查（表 provider_models，界面上点「刷新清单」拉）→ 保守兜底值
# （默认 128k，可在设置页改）」，``FALLBACK_CONTEXT_WINDOW`` 那几个键同理。
DEEPSEEK_CONTEXT_WINDOW=1048576
KIMI_CONTEXT_WINDOW=262144
GLM_CONTEXT_WINDOW=1048576
GPT_CONTEXT_WINDOW=128000
QWEN_CONTEXT_WINDOW=1048576
# 上下文压力提醒的两条线（占窗口比例，**只提示不改行为**；0 = 关掉那一档）：
# 60% 起在输入框上方画一条细进度条，80% 给警示语（提示「下一条消息可能触发压缩」）。
CONTEXT_WARN_RATIO=0.6
CONTEXT_ALERT_RATIO=0.8

# 工具裁剪（2026-10-22）：只在到达**压缩线**时生成持久化投影事件。事件只存工具调用 ID，
# 原始消息仍在 checkpoint；每次请求动态把大工具结果 / 大入参投影成占位符。
# 工具结果低于 2000 字符不裁；当前步骤与 KEEP 项永不进入事件。
CONTEXT_TRIM_TOOL_RESULTS=true
# 历史工具入参的选择性压缩。默认关；开启后只压超大字符串字段，保留 file_path / path /
# offset / limit / timeout，不再把整个 args 清成 {}。
CONTEXT_TRIM_CLEAR_INPUTS=false
# 结果 / 单个入参字符串的字符阈值。普通命令输出和短参数留在原位。
CONTEXT_PRETRIM_MIN_RESULT_CHARS=2000
CONTEXT_PRETRIM_MIN_ARG_CHARS=2000
# 临近压缩线先提醒模型写工作笔记（结论 / 精确标识符 / 未完成事项 + KEEP 清单）：
# 值是「压缩线 × 比例」，默认 0.9；0 = 关闭提醒。
CONTEXT_PRETRIM_NOTICE_RATIO=0.9

# 已作废（2026-10-17：常规剪裁已删，只保留压缩线处的应急裁剪）：
# CONTEXT_TRIM_TRIGGER_TOKENS=40000
# CONTEXT_TRIM_KEEP=12
# CONTEXT_TRIM_ROLES=main,planner,coder,reviewer

# 压缩（摘要）：什么时候压 / 压完留多少 / 摘要那次调用最多吃多少。三件都在这组里，
# **不上界面**（与上面的剪裁同属「调参」，口径见 docs/config-page-design.md 第九节）。
# 计数用**中英混合**口径（≈真实 token，见 agent/middleware/context_trim.py），
# 所以下面这几个数就是「真 token」的量级，不是被高估过 2.5 倍的估算值。
CONTEXT_SUMMARY_ENABLED=true
# 策略按角色分两档（2026-10-19）：
# 稳态（qa / analysis）：窗口 70% 触发；
# 爆发（主控 plan / review、子智能体 planner / coder / reviewer）：窗口 40% 触发。
# 爆发档读文件是常态，早点压；稳态档给问答/分析更多缓冲。
CONTEXT_STEADY_TRIGGER_FRACTION=0.70
CONTEXT_BURST_TRIGGER_FRACTION=0.40
# 触发线 = 比例 × 窗口 **或** 下面这条绝对上限（先到先触发）。2026-10-20 真机：
# coder 一轮 131 次调用、上下文涨到 194k 都没压 —— 40%×1M=400k，比例线太远。
CONTEXT_BURST_TRIGGER_TOKENS=120000
CONTEXT_STEADY_TRIGGER_TOKENS=200000
# 只有窗口解析不出来时才用这条绝对兜底线（比例线没法算）。
CONTEXT_SUMMARY_TRIGGER_TOKENS=120000
# 单轮输入合计超过这条线打一条 WARNING（只告警，不改变执行）。
TURN_COST_WARN_TOKENS=3000000
# 压完保留最近这么多 token。上游那个「窗口的 10%」在 1M 窗口下等于留 100k，
# 与 40%/70% 的比例触发线相比太大，压了等于没压 —— 所以这里也用绝对值。
CONTEXT_SUMMARY_KEEP_TOKENS=20000
# 摘要那次调用最多吃多少 token。上游**工厂**把这一格默认成「不裁」，等于把被逐出的全部
# 历史再发一遍给主控那个贵模型，还可能自己溢出（它不像主调用那样有兜底，溢出会把整轮
# 带崩）。原始全文另有 offload（/conversation_history/{thread_id}.md）且摘要里带路径可
# 回看，所以裁掉的是「更早的那部分不进摘要」，不是「丢了」。
CONTEXT_SUMMARY_INPUT_TOKENS=40000

GPT_API_KEY=
GPT_BASE_URL=https://api.ztoken.pro/v1/
GPT_MODEL_NAME=gpt-5.6-luna

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL_NAME=glm-5.3-flash

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen3.8-flash

# 降级兜底：**已作废**（2026-10-15）—— 兜底只认设置页「兜底模型」那一行（留空 = 关闭），
# 那一行与主模型同一套连接时会自动跳过；降级仍会往 agent.log 留一条 MODEL_FALLBACK 的痕。
FALLBACK_PROVIDER=deepseek
# 熔断：主导连续失败这么多次就开闸，冷却期内不再撞它、直接走兜底（记 MODEL_CIRCUIT）
# 阈值 0 = 关闭（退回每轮都撞一次主导）；冷却到点放一次探针，探针成功即恢复
FALLBACK_CIRCUIT_THRESHOLD=3
FALLBACK_CIRCUIT_COOLDOWN_SECONDS=60

# 意图分类（每轮一次）现在是**严格二选一**（2026-10-15）：口令 →（**JEV 或 大模型**，界面上选）
# → 关键字口径（没命中就是默认值 coding）。选哪一侧就只走哪一侧，不互相兜底。
INTENT_LLM_ENABLED=true
# **已作废**：分类模型改在设置页「意图识别（大模型）」那一行配
INTENT_MODEL=
INTENT_BASE_URL=
INTENT_API_KEY=
# 关思考没做成配置项：vLLM 只认 chat_template_kwargs.enable_thinking，写在代码里
# （build_classifier_model 的 extra_body），实测 2.8~5.0s → 0.3s
INTENT_TIMEOUT_SECONDS=5.0
# 判定时附带的历史用户消息条数（指代要靠它，如「就按你说的弄」）
INTENT_HISTORY_TURNS=4

# 本地多用户登录：首次使用前运行
#   python -m ai_coding_harness.manage create-admin --username admin --claim-existing
# Cookie 只保存随机不透明 token；会话哈希存 PostgreSQL，多 worker 不需要 sticky session。
AUTH_SESSION_COOKIE=harness_session
AUTH_CSRF_COOKIE=harness_csrf
# HTTPS 部署必须改成 true；本地 http://localhost 开发保持 false
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=168
AUTH_IDLE_TIMEOUT_HOURS=24
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_SECONDS=60

# JEV / SystemOne（决策型模型）—— SDK 是 `typesafe-sdk`，懒加载：没装包或没配齐就跳过 JEV，
# 判定落关键字口径，服务照常起。
# **2026-10-15 起凭据在设置页**：「意图识别（JEV）」那一行填 base_url + api_key
# （供应商锁死 typesafe），下面三个键因此作废，只有超时还从这里读。
INTENT_JEV_ENABLED=true
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL_NAME=jev-latest
TYPESAFE_TIMEOUT_SECONDS=10

# Gitee（代码平台）—— access token / git 用户名按用户在设置页「代码平台」配置，
# 不再从 .env 提供全局兜底。
GITEE_BASE_URL=https://gitee.com/api/v5

# GitHub（同一套 PR 工具，仓库地址是 github.com 时自动走这份配置）
# 需要 repo 权限的 PAT（classic: repo；fine-grained: Contents + Pull requests 读写），
# 同样按用户在设置页配置。
GITHUB_BASE_URL=https://api.github.com

# Persistence（LangGraph checkpointer + store，PostgreSQL）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_coding_harness
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# 建立连接的最长等待时间（秒）。地址不可达时尽快失败，避免 CLI / 服务长时间无响应。
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# Redis（**可选**）：多 worker 时的跨进程旁路状态 —— 一轮对话的帧缓冲（刷新后落到哪个
# worker 都能带游标接回）、会话运行权（同一会话不许两个 worker 同时跑）、模型熔断状态。
# 留空 = 全部留在进程内（单 worker 就是 2026-09-26 之前的行为）。
# 地址形如 redis://127.0.0.1:6379/0；**不写 scheme 也行**（`127.0.0.1:6379` 会自动按
# redis:// 处理）。密码单独写在 REDIS_PASSWORD 里 —— 别塞进 URL：URL 会进日志。
REDIS_URL=
REDIS_PASSWORD=
REDIS_PREFIX=harness:
# 版本化 Session 快照在 Redis 中使用 AES-256-GCM 加密。启用 Redis 时这两个键必填，
# 否则服务拒绝启动（避免 token 明文进 Redis，也避免多 worker 静默退回进程内缓存）。
# 生成密钥：python -m ai_coding_harness.manage generate-session-cache-key
SESSION_CACHE_ENCRYPTION_KEY=
SESSION_CACHE_KEY_VERSION=1
REDIS_SESSION_CACHE_TTL_SECONDS=300
# 生产多 worker 建议 true：连不上直接启动失败。已有部署只要配置了 REDIS_URL 仍可启动；
# false 时 Redis 故障会退回进程内。standalone 固定忽略 Redis，且不能开启本项。
REDIS_REQUIRED=true
# 单条命令超时。**Redis 在远端 / 走 SSH 隧道时必须放大**：实测「127.0.0.1:6379 其实是隧道」
# 时一次往返就有 60ms（p95 92ms），1 秒只给 16 倍余量，隧道抖一下就把进程打到降级。
REDIS_TIMEOUT_SECONDS=5.0
# 降级窗口：一次失败后退回进程内这么多秒，过了再试一次（不是永久降级）。设 0 ＝ 永不重试。
REDIS_DEGRADE_COOLDOWN_SECONDS=60
# 帧缓冲的存活时间与容量上限（超出上限从最老的帧开始丢）
RUN_BUFFER_TTL_SECONDS=3600
RUN_BUFFER_MAX_FRAMES=2000
# 会话运行权的 TTL（持有者进程被 kill 后的兜底）与「没有本地唤醒时」的轮询间隔
RUN_LOCK_TTL_SECONDS=120
RUN_POLL_INTERVAL_SECONDS=0.2
# 创建会话前先用当前用户凭据检查仓库可见性；无权或仓库不存在时不落会话。
VERIFY_REPO_ACCESS=true

# OpenSandbox
OPENSANDBOX_DOMAIN=192.168.72.128:8080
OPENSANDBOX_API_KEY=
OPENSANDBOX_REQUEST_TIMEOUT_SECONDS=600
# 沙箱探活缓存：距上次探活成功不足该秒数就跳过真探（0 = 每次调用都真探，更准但更慢）
SANDBOX_HEALTH_PROBE_TTL_SECONDS=5
# 沙箱续期：距上次续期超过该秒数就再续一次（到期时间推后一个 SANDBOX_TIMEOUT_MINUTES）；
# 0 = 关掉续期。默认 1800（30 分钟）= 默认 TTL 的一半，活跃会话不会因一轮跑太久被回收。
SANDBOX_RENEW_INTERVAL_SECONDS=1800
# 原生镜像已自带 git 2.43 / Java 21 / Maven 3.9 / Go 1.25.5 / Node 22；skill、规则、
# 凭据脚本由运行时注入（见下方 SANDBOX_ASSETS_DIR），无需再维护定制镜像
SANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
SANDBOX_ROOT=/ai_coding
# Maven 加速与缓存：settings.xml 走阿里云公共仓库镜像；本地仓库固定 /ai_coding/.m2/repository。
# 下面那组决定这个目录是否挂在卷上（挂上就跨容器重建存活，不必每次重新下依赖）。
SANDBOX_MAVEN_DIR=/ai_coding/maven
SANDBOX_MAVEN_CACHE_ENABLED=true
# true = 所有会话共用一个缓存卷（跨会话热；Docker 单机没问题，K8s 需要 RWX）
# false = 按会话各挂一个（独占无并发写，代价是新会话冷启动）
SANDBOX_MAVEN_CACHE_SHARED=true
SANDBOX_MAVEN_CACHE_PREFIX=ai-coding-m2
SANDBOX_MAVEN_CACHE_MOUNT_PATH=/ai_coding/.m2

# 工作区持久化（Volume）
SANDBOX_VOLUME_ENABLED=true
SANDBOX_VOLUME_PREFIX=ai-coding-ws
SANDBOX_VOLUME_DELETE_ON_TERMINATION=false
# 卷后端：pvc（本地命名卷/K8s PVC）| host（NFS 共享路径）| ossfs | none
SANDBOX_VOLUME_BACKEND=pvc
# host 后端：共享存储挂载根（每会话用子目录）
SANDBOX_VOLUME_HOST_PATH=
# pvc 后端（K8s 用；RWX 多写）
SANDBOX_VOLUME_STORAGE_CLASS=
SANDBOX_VOLUME_STORAGE=
SANDBOX_VOLUME_ACCESS_MODES=
# ossfs 后端
SANDBOX_OSS_BUCKET=
SANDBOX_OSS_ENDPOINT=
SANDBOX_OSS_VERSION=2.0
SANDBOX_OSS_ACCESS_KEY_ID=
SANDBOX_OSS_ACCESS_KEY_SECRET=

# 沙箱运行时资产：镜像不再预置 skill / 规则 / 凭据脚本，由应用在创建 / 重连沙箱时推入
SANDBOX_ASSETS_DIR=sandbox/deploy/sandbox
SANDBOX_LOCAL_SKILLS_DIR=sandbox/skills
SANDBOX_LOCAL_POLICIES_DIR=sandbox/policies
SANDBOX_SBIN_DIR=/usr/local/sbin
# 静态 git 身份（只有 commit 需要，与认证无关）
SANDBOX_GIT_USER_NAME=ai-coding-agent
SANDBOX_GIT_USER_EMAIL=agent@example.com

# 沙箱初始化：把注入的令牌写进 .secrets 的脚本（由 sandbox/deploy/sandbox/setup.sh 推入，勿含 exec tail）
SANDBOX_SETUP_COMMAND=/usr/local/sbin/setup.sh

# Service
HOST=127.0.0.1
PORT=8000

# 主智能体图的最大超级步数（LangGraph recursion_limit）；子智能体各自独立计数
AGENT_RECURSION_LIMIT=200

# 空转刹车：同一工具、同一参数在本轮出现到第 N 次就不再执行（回一条警告），第 N+1 次
# 直接中止本轮并补一条中断记录。按**本轮出现次数**计，不要求相邻（交错调用也算原地打转）
LOOP_GUARD_REPEATS=3

# handoffTask 交回外层模型时保留的正文上限（字符）；内层结果在外层只是个工具返回值
HANDOFF_RESULT_MAX=4000

# 日志：控制台 + 接口日志(api.log) + 智能体日志(agent.log)
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_API_FILE=api.log
LOG_AGENT_FILE=agent.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
# 工具参数 / 委派描述写进日志时的字符上限（超出截断并加省略号）
LOG_TOOL_ARG_MAX=2000
# 工具返回值写进日志时的字符上限（工具的成败常只体现在返回值里）
LOG_TOOL_RESULT_MAX=300
